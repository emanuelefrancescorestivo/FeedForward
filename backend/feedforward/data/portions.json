{
  "_note": [
    "Reference portions by food group, in grams. A recommendation compares what ONE realistic portion delivers against daily need, so 100 g of baking powder or dried sage can no longer outrank 150 g of lentils.",
    "Values are approximate everyday portions informed by the FDA Reference Amounts Customarily Consumed (21 CFR 101.12) and common EU portion guidance (e.g. 80 g of fruit or vegetables). They are for ranking, not for labelling, and should be reviewed by a dietitian.",
    "Rules are regular expressions matched against the lowercase, accent-free 'name | category' text. The FIRST matching rule wins, so specific rules come before general ones.",
    "category_regex, when present, must also match the category alone.",
    "A rule with \"on\": \"name\" is matched against the name only (default: name and category).",
    "OpenFoodFacts products are packaged as sold: cereals, pasta and legumes without a cooked/canned word are weighed dry (engine/portions.py)."
  ],
  "default_grams": 100,
  "rules": [
    {
      "group": "leavening",
      "grams": 2,
      "regex": "leavening|baking powder|baking soda|cream of tartar|levure chimique|bicarbonate|\\byeast\\b|levure"
    },
    {
      "group": "salt",
      "grams": 1,
      "regex": "^salt\\b|^sel\\b|bouillon cube|stock cube|\\bcube\\b"
    },
    {
      "group": "spices_herbs",
      "grams": 2,
      "regex": "\\bspices?\\b|\\bepices?\\b|herbes|spices and herbs|\\bherbs?\\b|condiments|\\bsavory\\b|\\bsarriette\\b|\\bdried (thyme|oregano|basil|rosemary|sage|mint)"
    },
    {
      "group": "fresh_herbs",
      "grams": 5,
      "regex": "lemon ?grass|citronelle|\\bparsley\\b|\\bpersil\\b|\\bbasil\\b|basilic|coriander|cilantro|\\bdill\\b|\\baneth\\b|\\bmint\\b|\\bmenthe\\b|chives|ciboulette|rosemary|romarin|\\bthyme\\b|\\bthym\\b|\\bsage\\b|\\bsauge\\b|tarragon|estragon|oregano|origan|chervil|cerfeuil"
    },
    {
      "group": "dried_seaweed",
      "grams": 5,
      "regex": "(seaweed|algue|agar|kelp|spirulina|nori|wakame).*(dried|dry|sec|seche)|(dried|dry|sec|seche).*(seaweed|algue|agar|kelp|spirulina)|spirulina|agar"
    },
    {
      "group": "powders",
      "grams": 5,
      "regex": "\\bpowder\\b|\\bpoudre\\b|\\binstant\\b|drink mix|\\bdry mix\\b|cocoa, dry"
    },
    {
      "group": "freeze_dried",
      "grams": 5,
      "regex": "freeze-dried|freeze dried|dehydrated|lyophilis"
    },
    {
      "group": "dried_vegetables",
      "grams": 10,
      "regex": "(peppers?|chil(i|e|ies)|piment|tomato|tomate|mushroom|champignon|onion|oignon|parsley|persil|garlic|\\bail\\b).*(\\bdried\\b|\\bdry\\b|\\bsecs?\\b|\\bseches?\\b|sun-dried)"
    },
    {
      "group": "dried_fruit_any",
      "grams": 40,
      "regex": "\\b(dried|dehydrated)\\b.*\\| fruits and fruit juices"
    },
    {
      "group": "dried_vegetables_any",
      "grams": 10,
      "regex": "\\b(dried|dehydrated)\\b.*\\| vegetables and vegetable products"
    },
    {
      "group": "textured_protein",
      "grams": 30,
