# Copy to .env. Do not commit real secrets.
FEEDFORWARD_DATABASE_URL=postgresql+psycopg://feedforward:feedforward@localhost:5432/feedforward
FEEDFORWARD_SECRET=replace-with-a-long-random-string
FEEDFORWARD_ENV=development
# Comma-separated origins. Use * only for local Expo. Production must list the app origin.
FEEDFORWARD_CORS_ORIGINS=*
FEEDFORWARD_RATE_LIMIT=120
# Set to 1 to force engine/build.py to read the database even outside the API.
FEEDFORWARD_READ_DATABASE=0
# Google sign-in: the OAuth client ID (public, not a secret). Unset: no Google button.
FEEDFORWARD_GOOGLE_CLIENT_ID=
# The test sign-in by name, for a developer's machine. Always off when FEEDFORWARD_ENV=production.
FEEDFORWARD_DEV_LOGIN=1
